# ===========================================
# Zeitstrahl - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values

# General
# -------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Zeitstrahl

# Analytics (optional)
# --------------------
# NEXT_PUBLIC_ANALYTICS_ID=

# Feature Flags
# -------------
NEXT_PUBLIC_ENABLE_CLOUD_SYNC=false
NEXT_PUBLIC_ENABLE_COLLABORATION=false

# Database (optional, for cloud features)
# ---------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/zeitstrahl
# DATABASE_DIRECT_URL=postgresql://user:password@localhost:5432/zeitstrahl

# Authentication (optional)
# -------------------------
# AUTH_SECRET=your-secret-key-here
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# External Services (optional)
# ----------------------------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Error Tracking (optional)
# -------------------------
# NEXT_PUBLIC_SENTRY_DSN=
